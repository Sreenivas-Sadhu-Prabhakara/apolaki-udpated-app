# Admin Service Environment Variables
# Copy to .env and fill in values

# Server
PORT=3002
NODE_ENV=development

# Database — use a restricted admin role connection string
DATABASE_URL=postgresql://apolaki_admin_rw:password@localhost:5432/apolaki

# JWT
JWT_SECRET=your-jwt-secret-here
ADMIN_JWT_EXPIRY=15m
ADMIN_REFRESH_EXPIRY=8h

# CORS — frontend origin allowed to call admin endpoints
CORS_ORIGIN=http://localhost:5173

# Internal service token — shared secret for service-to-service /internal/* calls
INTERNAL_SERVICE_TOKEN=change-this-internal-secret

# Optional: comma-separated CIDRs to allowlist for admin access
# ADMIN_ALLOWED_CIDRS=127.0.0.1/32,10.0.0.0/8

# Optional: forward audit events to this URL from other services
AUDIT_WEBHOOK_URL=
