# Development Environment Variables

# Application
APP_NAME=Apolaki
APP_ENV=development
APP_DEBUG=true
APP_PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=apolaki_user
DB_PASS=apolaki_pass
DB_NAME=apolaki_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=apolaki
RABBITMQ_PASS=apolaki_pass

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=24h

# API
API_PORT=8080
API_HOST=localhost

# Frontend
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws

# External Services
WEATHER_API_KEY=your_openweather_api_key
S3_BUCKET=apolaki-dev
S3_REGION=us-east-1

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
